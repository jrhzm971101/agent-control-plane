    "markdown-it": "^15.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
