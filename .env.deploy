# 部署形态：npm run build:deploy（vite build --mode deploy）。
#
# 这两个值不是自由发挥，对应一体化平台（md-admin-platform）里 platform 表的登记：
#   platform.home_path = /agent/            → 门户跳转用的**页面**段
#   platform.api_prefix = /agent-platform/** → 网关路由用的**接口**前缀
#
# 两者刻意分开：混成一个会让"页面路径"被网关当成"要校验平台权限的接口"。
# 接口前缀同时等于 agent 服务的 context-path（网关原样转发、不做 StripPrefix），
# 也就是「服务名 = 一级路径」这条约定。
VITE_PUBLIC_PATH=/agent/
VITE_API_BASE=/agent-platform

# 部署产物里没有演示数据的意义：假数据混进真实环境，比报错更难查。
VITE_TRACES_MOCK=false

# ── 登录票 ────────────────────────────────────────────────────────────────
# 票由统一门户（md-portal-homepage）登录时写进 localStorage，本平台只读，
# 两个存储键（md.token / md.refresh）必须与门户的 src/lib/session.ts 一致 ——
# 对不上就只是"从门户跳进来满屏 401"，本地独立开发永远复现不了。
#
# 留空 = 同源：走入口 nginx 的同名路径。刻意与 VITE_API_BASE 分开，
# 因为换票打的是 iam 的 /api/auth/refresh，不该被拼上 /agent-platform 前缀。
VITE_IAM_BASE=

# 生产必须 false：后端网关（GatewaySecurityConfig）除白名单外都要求有效
# Bearer 票 + platforms 里的 agent 准入，不发头会被拦成 401。
# 只有本地把后端门禁一起关掉（md.security.enabled=false）时才设为 true。
VITE_AUTH_DISABLED=false

# ── 平台切换 / 返回门户 ──────────────────────────────────────────────────
# 顶栏那两颗按钮跳的是**别的应用**，地址来自统一门户登记的 platform.home_path。
# 变量名与门户首页（md-portal-homepage/src/lib/platforms.ts）用的是同一组，
# 两边同时留空时回落到同样的路径兜底 —— 之所以两边各写死一份目录，
# 是因为 iam 还没有 GET /api/platforms（见 src/app/platforms.ts 的文件头）。
#
# 三个平台与门户同域（见上面 VITE_PUBLIC_PATH 的说明），所以相对路径就够；
# 换域名 / 换端口时在这里覆盖，不必改代码。
VITE_PORTAL_URL=/
VITE_DATA_URL=/data/
VITE_ADMIN_URL=/admin/

# 本平台的页面地址。当前平台不出现在切换列表里，所以它今天只是目录里的一条记录；
# 留着的用处是把"门户登记的地址"与"本平台实际的地址"放在同一处比对，
# 等 iam 出 GET /api/platforms 时这两边要对得上。
VITE_AGENT_URL=/agent/
